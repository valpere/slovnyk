# Install as /etc/slovnyk/http.env, root:root 0600; replace all placeholders.
SLOVNYK_HTTP_ADDR=127.0.0.1:8080
SLOVNYK_LOG_LEVEL=info
SLOVNYK_SEARCH_TIMING=false
SLOVNYK_SHUTDOWN_TIMEOUT=10s
SLOVNYK_HTTP_DSN=postgres://slovnyk_http_login:REPLACE_PASSWORD@127.0.0.1:55432/slovnyk?sslmode=disable
SLOVNYK_ARTIFACT_ROOT=/srv/slovnyk/artifacts
SLOVNYK_CURSOR_ACTIVE_KID=v1
SLOVNYK_CURSOR_KEYS=v1:REPLACE_WITH_64_HEX_CHARACTERS

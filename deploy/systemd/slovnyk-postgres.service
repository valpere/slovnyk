[Unit]
Description=Slovnyk dedicated PostgreSQL container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/slovnyk/postgres

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/slovnyk/deploy
ExecStart=/usr/bin/docker compose --env-file /etc/slovnyk/postgres.env -f /opt/slovnyk/deploy/compose.yaml up -d --wait db
ExecStop=/usr/bin/docker compose --env-file /etc/slovnyk/postgres.env -f /opt/slovnyk/deploy/compose.yaml stop db
TimeoutStartSec=360
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

# Optional: copy to .env and load explicitly: set -a; . ./.env; set +a
SLOVNYK_HTTP_ADDR=127.0.0.1:8080
SLOVNYK_LOG_LEVEL=info
SLOVNYK_SHUTDOWN_TIMEOUT=10s
# Local disposable PostgreSQL only. These credentials are not for deployment.
SLOVNYK_DEV_DB_PORT=55432
POSTGRES_USER=slovnyk_dev
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=slovnyk_dev
# Explicit migration command only; never use this owner login for HTTP.
# SLOVNYK_MIGRATION_DSN=postgres://slovnyk_dev:local-development-only@127.0.0.1:55432/slovnyk_dev?sslmode=disable

# Import CLI only: separate LOGIN inheriting slovnyk_operator, database TEMP.
# SLOVNYK_OPERATOR_DSN=postgres://<operator-login>:<password>@127.0.0.1:55432/slovnyk_dev?sslmode=disable

# Read-only HTTP LOGIN inheriting slovnyk_http; configure both or neither.
# SLOVNYK_HTTP_DSN=postgres://<http-login>:<password>@127.0.0.1:55432/slovnyk_dev?sslmode=disable
# SLOVNYK_ARTIFACT_ROOT=/absolute/path/to/slovnyk/data/artifacts

# Required with HTTP storage. Generate a secret: openssl rand -hex 32
# Keep old keys while their continuation links are supported; never commit keys.
# SLOVNYK_CURSOR_ACTIVE_KID=v1
# SLOVNYK_CURSOR_KEYS=v1:<64-hex-characters>,old:<retained-key-hex>
